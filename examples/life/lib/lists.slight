; Helpers shared by the Game of Life examples and the runner: lists, and
; environments for processes. The language has cons, car, cdr, list, append
; and fold; everything else is here.

; ---------------------------------------------------------------------------
; Environments for processes
; ---------------------------------------------------------------------------

; The environment a process runs in: `code`, a role holding the process's
; own procedures, composed onto the CPI's environment, which supplies the
; library procedures the role requires. Resolving it checks that every name
; the role requires is filled and every host action it requires is in
; `grants`. Building one costs about 10 microseconds, but parking a process
; hashes its environment once per environment, so when processes will be
; parked, build one and spawn them all in it.
(defun process-env (code grants)
    (environment::resolve (environment::compose (environment::self) code) grants))

; A process that applies the procedure named `name` in `env` to `args`.
(defun spawn-in (env name args grants mailbox)
    (process::spawn (environment::lookup env name) args env grants mailbox))

; ---------------------------------------------------------------------------
; Lists
; ---------------------------------------------------------------------------

(defun second (xs) (car (cdr xs)))
(defun third (xs) (car (cdr (cdr xs))))

; A walk over a whole list is a fold: it costs one tick per element plus
; the ticks of the procedure folded.

(defun length (xs)
    (fold (lambda (n x) (+ n 1)) 0 xs))

(defun list-ref (xs i)
    (if (= i 0)
        (car xs)
        (list-ref (cdr xs) (- i 1))))

(defun reverse (xs)
    (reverse-onto xs ()))

(defun reverse-onto (xs acc)
    (fold (lambda (ys x) (cons x ys)) acc xs))

; (range 0 3) is (0 1 2).
(defun range (from to)
    (range-down from (- to 1) ()))

(defun range-down (from i acc)
    (if (< i from)
        acc
        (range-down from (- i 1) (cons i acc))))

; Built backwards and reversed: from two elements on, two folds cost fewer
; ticks than one recursive pass. f is applied to the elements in order.
(defun map (f xs)
    (reverse (fold (lambda (ys x) (cons (f x) ys)) () xs)))

(defun for-each (f xs)
    (fold (lambda (r x) (f x)) () xs)
    ())

(defun filter (keep? xs)
    (reverse (fold (lambda (ys x) (if (keep? x) (cons x ys) ys)) () xs)))

(defun sum (xs)
    (fold + 0 xs))

(defun any? (pred xs)
    (and (not (nil? xs))
        (or (pred (car xs)) (any? pred (cdr xs)))))

(defun all? (pred xs)
    (or (nil? xs)
        (and (pred (car xs)) (all? pred (cdr xs)))))

(defun member? (x xs)
    (any? (lambda (y) (eq? x y)) xs))
