; List helpers shared by the Game of Life examples. The language has only
; cons, car and cdr, so everything else is written here.

(defun list2 (a b) (cons a (cons b ())))
(defun list3 (a b c) (cons a (cons b (cons c ()))))

(defun second (xs) (car (cdr xs)))
(defun third (xs) (car (cdr (cdr xs))))

(defun length (xs)
    (length-from xs 0))

(defun length-from (xs n)
    (if (nil? xs)
        n
        (length-from (cdr xs) (+ n 1))))

(defun list-ref (xs i)
    (if (= i 0)
        (car xs)
        (list-ref (cdr xs) (- i 1))))

(defun reverse (xs)
    (reverse-onto xs ()))

(defun reverse-onto (xs acc)
    (if (nil? xs)
        acc
        (reverse-onto (cdr xs) (cons (car xs) acc))))

(defun append (xs ys)
    (reverse-onto (reverse xs) ys))

; (range 0 3) is (0 1 2).
(defun range (from to)
    (range-down from (- to 1) ()))

(defun range-down (from i acc)
    (if (< i from)
        acc
        (range-down from (- i 1) (cons i acc))))

(defun map (f xs)
    (reverse (map-onto f xs ())))

(defun map-onto (f xs acc)
    (if (nil? xs)
        acc
        (map-onto f (cdr xs) (cons (f (car xs)) acc))))

(defun for-each (f xs)
    (when (not (nil? xs))
        (f (car xs))
        (for-each f (cdr xs))))

(defun filter (keep? xs)
    (reverse (filter-onto keep? xs ())))

(defun filter-onto (keep? xs acc)
    (cond
        ((nil? xs) acc)
        ((keep? (car xs)) (filter-onto keep? (cdr xs) (cons (car xs) acc)))
        (#true (filter-onto keep? (cdr xs) acc))))

(defun fold (f acc xs)
    (if (nil? xs)
        acc
        (fold f (f acc (car xs)) (cdr xs))))

(defun sum (xs)
    (fold + 0 xs))

(defun any? (pred xs)
    (and (not (nil? xs))
         (or (pred (car xs)) (any? pred (cdr xs)))))

(defun all? (pred xs)
    (or (nil? xs)
        (and (pred (car xs)) (all? pred (cdr xs)))))

(defun member? (x xs)
    (any? (lambda (y) (eq? x y)) xs))
