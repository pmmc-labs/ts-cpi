; Helpers shared by the Game of Life examples and the runner: lists, and
; environments for processes. The language has cons, car, cdr, list and
; append; everything else is here.

; ---------------------------------------------------------------------------
; Environments for processes
; ---------------------------------------------------------------------------

; The environment a process runs in: `code`, a role holding the process's
; own procedures, composed onto exactly the names it requires from the CPI's
; environment and nothing else. A library procedure calls other procedures
; by name, so a role must require those too: its `require` forms list
; everything the process can reach. Resolving the result checks that every
; name is filled and every host action the role requires is in `grants`.
; Parking a process hashes its environment once per environment, so when
; processes will be parked, build one and spawn them all in it.
(defun process-env (code grants)
    (environment::resolve
        (environment::compose (environment::select (environment::self) (environment::required code)) code)
        grants))

; A process that applies the procedure named `name` in `env` to `args`.
(defun spawn-in (env name args grants mailbox)
    (process::spawn (environment::lookup env name) args env grants mailbox))

; ---------------------------------------------------------------------------
; Lists
; ---------------------------------------------------------------------------

(defun second (xs) (car (cdr xs)))
(defun third (xs) (car (cdr (cdr xs))))

(defun length (xs)
    (length-from xs 0))

(defun length-from (xs n)
    (if (nil? xs)
        n
        (length-from (cdr xs) (+ n 1))))

(defun list-ref (xs i)
    (if (= i 0)
        (car xs)
        (list-ref (cdr xs) (- i 1))))

(defun reverse (xs)
    (reverse-onto xs ()))

(defun reverse-onto (xs acc)
    (if (nil? xs)
        acc
        (reverse-onto (cdr xs) (cons (car xs) acc))))

; (range 0 3) is (0 1 2).
(defun range (from to)
    (range-down from (- to 1) ()))

(defun range-down (from i acc)
    (if (< i from)
        acc
        (range-down from (- i 1) (cons i acc))))

; One pass, not in tail position: each cons waits on the continuation, which
; lives on the heap, so long lists are fine. It is faster than building the
; list backwards and reversing it.
(defun map (f xs)
    (if (nil? xs)
        ()
        (cons (f (car xs)) (map f (cdr xs)))))

(defun for-each (f xs)
    (when (not (nil? xs))
        (f (car xs))
        (for-each f (cdr xs))))

(defun filter (keep? xs)
    (reverse (filter-onto keep? xs ())))

(defun filter-onto (keep? xs acc)
    (cond
        ((nil? xs) acc)
        ((keep? (car xs)) (filter-onto keep? (cdr xs) (cons (car xs) acc)))
        (#true (filter-onto keep? (cdr xs) acc))))

(defun fold (f acc xs)
    (if (nil? xs)
        acc
        (fold f (f acc (car xs)) (cdr xs))))

(defun sum (xs)
    (fold + 0 xs))

(defun any? (pred xs)
    (and (not (nil? xs))
        (or (pred (car xs)) (any? pred (cdr xs)))))

(defun all? (pred xs)
    (or (nil? xs)
        (and (pred (car xs)) (all? pred (cdr xs)))))

(defun member? (x xs)
    (any? (lambda (y) (eq? x y)) xs))
