; 05 · Trapped world
;
; The control plane as the laws of physics. Every cell is a process that
; believes it lives in a message-passing world: each generation it tells its
; eight neighbors how it is (`actor::send`), listens to what they say
; (`actor::recv`), applies Conway's rule, and goes round again. It knows the
; mailbox addresses of its neighbors and nothing else.
;
; None of those messages is ever delivered. The CPI calls
; `(host::set-traps '(send recv))` before anything runs, so every `send` and
; every `recv` stops the cell with `(trap send (<addr> <msg>))` or
; `(trap recv ())` and hands the effect to the CPI, which *is* the world:
;
;   send   the CPI writes the announced state into its ledger (the board)
;          and answers `(process::resume pid #true)`, the "sent" a real
;          `actor::send` would have returned;
;   recv   the CPI answers `(process::resume pid (state s))` with a
;          neighbor's state from the previous ledger, a message nobody sent.
;
; Between generations every cell is frozen inside a trapped `recv` with no
; answer yet: time stops for it until the world decides what it hears. The
; ledger is double-buffered: a cell's answers all come from the old board,
; while the states it announces go into the new one.
;
; At the end the CPI counts the messages sitting in the cells' real mailboxes.
; There are none: every effect the cells performed was implemented by the CPI.
;
; CPI features: `host::set-traps`, `(trap ...)` stop reasons,
; `process::resume` as the answer to an effect, `mailbox::create` for
; addresses that are never used, `mailbox::size`, `process::kill`.

; Ticks per run. A cell traps long before this runs out.
(const tw-quota 10000)

; The cell whose conversation with the world is printed in the first
; generation.
(const tw-narrated '(1 2))

; ---------------------------------------------------------------------------
; Inside a cell (granted actor only)
; ---------------------------------------------------------------------------

; A cell's code, as a role. Its sends and recvs all trap to the CPI, but it
; still declares them: they are its interface.
(defun tw-cell-code ()
    (role
        (require actor::recv actor::send)
        (require for-each life-rule second)

        ; A cell's whole life: announce, listen, apply the rule, repeat. Its state is
        ; the argument `state`; `neighbors` are eight mailbox addresses.
        (defun tw-cell (neighbors state)
            (tw-announce neighbors state)
            (tw-cell neighbors (life-rule state (tw-listen 8 0))))

        (defun tw-announce (neighbors state)
            (for-each (lambda (n) (actor::send n (list :state state))) neighbors))

        ; Receives `k` messages of the form (state s) and sums the states.
        (defun tw-listen (k total)
            (if (= k 0)
                total
                (tw-listen (- k 1) (+ total (second (actor::recv))))))))

; ---------------------------------------------------------------------------
; The world (the CPI)
; ---------------------------------------------------------------------------

(defun tw-say (narrate? pos what detail)
    (when narrate?
        (IO::print "    | cell" pos what detail)))

; Runs a cell until it asks for news the world has no answer for yet.
; `answers` are the messages still owed to it this generation. Returns
; (said traps): the state it announced, and how many effects the world
; carried out on its behalf.
(defun tw-drive (pid pos narrate? answers said traps)
    (let r (process::run pid tw-quota))
    (case (car r)
        (:quota (tw-drive pid pos narrate? answers said traps))
        (:trap
            (let effect (second r))
            (let args (third r))
            (cond
                ((eq? effect :send)
                    (let msg (second args))
                    (when narrate?
                        (IO::print "    | cell" pos "actor::send" msg "->" (car args) "captured; resumed with #true"))
                    (process::resume pid #true)
                    (tw-drive pid pos narrate? answers (second msg) (+ traps 1)))
                ((nil? answers)
                    (tw-say narrate? pos "actor::recv" "... frozen until the next generation")
                    (list said traps))
                (#true
                    (tw-answer pid pos narrate? (car answers))
                    (tw-drive pid pos narrate? (cdr answers) said (+ traps 1)))))
        (else (throw (make-error :tw-escaped "a cell left the world" r)))))

(defun tw-answer (pid pos narrate? msg)
    (tw-say narrate? pos "actor::recv  <- world answers" msg)
    (process::resume pid msg))

; What the cell at (row col) hears this generation: its neighbors' states on
; the old board, in the order it listed its neighbors.
(defun tw-answers (board row col)
    (map (lambda (p) (list :state (cell-at board (car p) (second p))))
        (neighbors-of row col)))

; One generation for one cell. The cell is frozen in the `recv` where the
; last generation left it, so the first answer is a resume, not a run.
(defun tw-step (pid board row col narrate?)
    (let answers (tw-answers board row col))
    (tw-answer pid (list row col) narrate? (car answers))
    (tw-drive pid (list row col) narrate? (cdr answers) #false 1))

(defun tw-states (results)
    (map (lambda (row) (map car row)) results))

(defun tw-traps (results)
    (sum (map (lambda (row) (sum (map second row))) results)))

(defun tw-mail (boxes)
    (sum (map (lambda (row) (sum (map (lambda (b) (mailbox::size b)) row))) boxes)))

(defun tw-world (gen pids boxes board carried)
    (print-board gen board)
    (IO::print "    [world]" carried "effects trapped so far;" (tw-mail boxes) "messages in real mailboxes")
    (if (< gen life-generations)
        (do
            (let narrate-gen? (= gen 0))
            (when narrate-gen?
                (IO::print "    [world] listening in on cell" tw-narrated "on its way to generation 1:"))
            (let results
                (make-board (lambda (row col)
                        (tw-step (cell-at pids row col) board row col
                            (and narrate-gen? (member-cell? row col (list tw-narrated)))))))
            (tw-world (+ gen 1) pids boxes (tw-states results) (+ carried (tw-traps results))))
        (do
            (for-each (lambda (row) (for-each (lambda (p) (process::kill p :end-of-the-world)) row)) pids)
            (IO::print "    [world] the cells are stopped. They sent and received" carried "messages,")
            (IO::print "    [world] and their mailboxes hold" (tw-mail boxes) "of them: the world implemented every effect."))))

(defun main ()
    (host::set-traps '(send recv))
    (IO::print "    [world] traps set: every actor::send and actor::recv now comes to the CPI")
    ; Every cell gets a real mailbox, so it has a real address its neighbors
    ; can name. Nothing will ever be put in one.
    (let boxes (make-board (lambda (row col) (mailbox::create #true 8))))
    (let seed (seed-board))
    (let env (process-env (tw-cell-code) '(actor)))
    (let pids
        (make-board (lambda (row col)
                (spawn-in env 'tw-cell
                    (list (map (lambda (p) (cell-at boxes (car p) (second p)))
                            (neighbors-of row col))
                        (cell-at seed row col))
                    '(actor) (cell-at boxes row col)))))
    ; Generation 0: each cell announces its seed state and stops to listen.
    ; The world reads the first board from what they said.
    (let results
        (make-board (lambda (row col) (tw-drive (cell-at pids row col) (list row col) #false () #false 0))))
    (tw-world 0 pids boxes (tw-states results) (tw-traps results)))
