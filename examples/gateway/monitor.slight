; Runs the gateway (gateway.slight) under a live monitor on the terminal:
;
;     node bin/cpi.ts examples/gateway/gateway.slight examples/gateway/monitor.slight
;
; Keys: q quits, + and - change the most hello workers, f changes the frame
; rate. The monitor is one more step in the CPI's loop: while it draws,
; nothing else runs, so it draws on a timer, and its header shows what the
; drawing costs.
;
; The CPI's events are not shown. Each is sent to a mailbox nobody receives
; on, so it ends up in the host's dead-letter queue.

(const fps-default 4)
(const fps-choices '(1 2 4 10 30))

(defun main ()
    (tui::open 'fullscreen)
    (let keys (mailbox::create #true 64))
    (tui::subscribe keys)
    (let started (start-gateway))
    (let ui (vector keys fps-default 0 (dead-letter-box) 0))
    (let final (gateway (car started) (second started) (cons monitor ui)))
    (http::close gateway-port)
    (tui::close)
    (IO::print "[gateway] stopped:" (stats final)))

; A mailbox whose only receiver has ended: everything sent to it is a dead
; letter.
(defun dead-letter-box ()
    (let box (mailbox::create #false 1))
    (let env (role (defun done () #true)))
    (process::run (process::spawn (environment::lookup env 'done) () env '() box) 10)
    box)

; The UI step: reads keys, sends new events to the dead-letter box, and draws
; a frame when one is due. The UI state is a vector: the keys mailbox, frames
; per second, when the next frame is due, the dead-letter box, and the
; newest event sent there.
(defun monitor (ui w st now)
    (let keyed (read-keys ui st))
    (let st2 (second keyed))
    (let ui2 (discard-events (car keyed) st2))
    (let frame-ms (/ 1000 (vector-ref ui2 1)))
    (if (>= now (vector-ref ui2 2))
        (do
            (let view (monitor-view w st2 ui2 now))
            (let built (host::now))
            (tui::render view)
            (list (vector-set ui2 2 (+ now frame-ms)) (add-frame st2 (- built now)) (min2 check-ms frame-ms)))
        (list ui2 st2 (min2 check-ms (- (vector-ref ui2 2) now)))))

(defun discard-events (ui st)
    (for-each (lambda (e) (mailbox::send (vector-ref ui 3) e)) (reverse (newer-than (st-events st) (vector-ref ui 4))))
    (if (nil? (st-events st)) ui (vector-set ui 4 (car (car (st-events st))))))

(defun read-keys (ui st)
    (let event (mailbox::take (vector-ref ui 0)))
    (cond
        ((not event) (list ui st))
        ((eq? (car event) :key)
            (let handled (on-key (second event) (third event) ui st))
            (read-keys (car handled) (second handled)))
        (#true (read-keys ui st))))

(defun on-key (name mods ui st)
    (cond
        ((or (eq? name "q") (and (eq? name "c") (member? 'ctrl mods)))
            (list ui (stop (log-event st "quit from the keyboard"))))
        ((or (eq? name "+") (eq? name "="))
            (list ui (set-hello-max st (+ (st-hello-max st) 1))))
        ((eq? name "-")
            (list ui (set-hello-max st (- (st-hello-max st) 1))))
        ((eq? name "f")
            (list (vector-set ui 1 (next-fps (vector-ref ui 1) fps-choices)) st))
        (#true (list ui st))))

(defun next-fps (fps choices)
    (cond
        ((nil? choices) (car fps-choices))
        ((and (= (car choices) fps) (not (nil? (cdr choices)))) (car (cdr choices)))
        ((= (car choices) fps) (car fps-choices))
        (#true (next-fps fps (cdr choices)))))

; ---------------------------------------------------------------------------
; Text pieces. A line is a Text of pieces; nested Text runs inline.

(defun span (color text) `(Text (@ (color ,color)) ,text))
(defun dim (text) `(Text (@ (dimColor #true)) ,text))
(defun bold (text) `(Text (@ (bold #true)) ,text))
(defun line (pieces) `(Text ,@pieces))

; `label n`, n right-aligned in `width` columns, in `color` when n is not
; 0, dimmed when it is.
(defun count-span (label n width color)
    (let text (string-append label " " (pad-left (value->string n) width)))
    (if (= n 0) (dim text) (span color text)))

; `s` right-aligned in `width` columns, so a number that grows does not move
; what follows it.
(defun pad-left (s width)
    (string-append (repeat-string " " (- width (string-length s))) s))

(defun num (n width) (pad-left (value->string n) width))

; A percentile bin's label, green under 5 ms, yellow under 50 ms, red above.
(defun bin-span (i)
    (cond
        ((< i 0) (dim "-"))
        ((<= i 2) (span 'green (bin-label i)))
        ((<= i 5) (span 'yellow (bin-label i)))
        (#true (span 'red (bin-label i)))))

(defun separated (pieces)
    (cond
        ((nil? pieces) ())
        ((nil? (cdr pieces)) pieces)
        (#true (cons (car pieces) (cons (dim " · ") (separated (cdr pieces)))))))

; ---------------------------------------------------------------------------
; The view: a header, a row per endpoint for the last second, and a row per
; endpoint for everything since the start.

(defun monitor-view (w st ui now)
    `(Box (@ (flexDirection column))
        ,(header-view st ui now)
        ,(table-view w st)
        ,(acc-view st)
        ,(dim " q quit · + / - hello max · f frame rate")))

(defun header-view (st ui now)
    (let counts (m-status (st-metrics st)))
    `(Box (@ (borderStyle round) (borderColor cyan) (flexDirection column) (paddingX 1))
        ,(line
            (separated
                (list
                    (title (string-append "gateway :" (value->string gateway-port)))
                    (string-append "up " (clock-text now))
                    (string-append "hello max " (num (st-hello-max st) 2))
                    (string-append (num (vector-ref ui 1) 2) " fps"))))
        ,(line
            (separated
                (list
                    (bold (string-append "requests " (num (vector-ref counts 0) 7)))
                    (count-span "2xx" (vector-ref counts 1) 7 'green)
                    (count-span "4xx" (vector-ref counts 2) 5 'yellow)
                    (count-span "503" (vector-ref counts 3) 5 'red)
                    (count-span "504" (vector-ref counts 4) 5 'red)
                    (count-span "5xx" (vector-ref counts 5) 5 'red)
                    (count-span "gone" (vector-ref counts 6) 5 'yellow))))
        ,(line (separated (loop-pieces (m-phases (st-metrics st)))))
        ,(loop-bar (m-phases (st-metrics st)))))

; The same split as a bar, drawn by the host.
(defun loop-bar (p)
    (let parts
        (list (list "run" (vector-ref p 1) 'blue) (list "other" (vector-ref p 2) 'yellow)
            (list "draw" (vector-ref p 3) 'magenta) (list "wait" (vector-ref p 4) 'gray)))
    `(StackedBarChart (@ (width 60) (showLabels #false) (showValues #false)
        (data ,(if (= 0 (fold (lambda (n x) (+ n (second x))) 0 parts)) (list (list "wait" 1 'gray)) parts)))))

(defun title (text) `(Text (@ (bold #true) (color cyan)) ,text))

; The last second of the loop: how often it went round, the share of its
; time spent running processes, on its own work, drawing and waiting, and
; what a frame cost.
(defun loop-pieces (p)
    (let total (max2 1 (+ (vector-ref p 1) (+ (vector-ref p 2) (+ (vector-ref p 3) (vector-ref p 4))))))
    (list
        (string-append "loop " (num (vector-ref p 0) 5) "/s")
        (span 'blue (percent "run" (vector-ref p 1) total))
        (span 'yellow (percent "other" (vector-ref p 2) total))
        (span 'magenta (percent "draw" (vector-ref p 3) total))
        (dim (percent "wait" (vector-ref p 4) total))
        (if (= (vector-ref p 5) 0)
            (dim "no frames")
            (string-append "frame " (num (/ (vector-ref p 3) (vector-ref p 5)) 3) " ms, "
                (num (/ (vector-ref p 6) (vector-ref p 5)) 3) " building"))))

(defun percent (label n total)
    (string-append label " " (num (/ (* n 100) total) 3) "%"))

(defun clock-text (ms)
    (let s (% (/ ms 1000) 60))
    (string-append (value->string (/ ms 60000)) (if (< s 10) ":0" ":") (value->string s)))

; ---------------------------------------------------------------------------
; Tables. A column is (title width) or (title width right); a right column
; holds numbers and is right-aligned, header included. A cell is a string, a
; Text element, or a list of pieces.

(const columns
    '(("endpoint" 10) ("workers" 22) ("queue" 7 right) ("req/s" 7 right) ("wait p95" 10 right)
        ("work p95" 10 right) ("ticks/s" 11 right) ("req/s, 20 s" 22) ("p95, 20 s" 21)))

; Each summary is min, avg and max in fixed widths (see summary-text), so
; its three numbers stay in columns as they grow. Its header has two rows:
; the quantity, then min, avg and max over their numbers.
(const acc-columns
    '(("since start" 12) ("requests" 10 right) ("queue" 20 right) ("req/s" 20 right)
        ("wait ms" 20 right) ("work ms" 20 right)))

(defun right? (column)
    (and (not (nil? (cdr (cdr column)))) (eq? (third column) 'right)))

(defun align (column)
    (if (right? column) 'flex-end 'flex-start))

(defun header-cell (column)
    `(Box (@ (width ,(second column)) (flexShrink 0) (paddingRight 1) (justifyContent ,(align column)))
        (Text (@ (dimColor #true)) ,(car column))))

(defun row-of (cols cells)
    `(Box (@ (flexDirection row)) ,@(cell-views cols cells)))

(defun cell-views (cols cells)
    (if (nil? cols)
        ()
        (cons (cell-view (car cols) (car cells)) (cell-views (cdr cols) (cdr cells)))))

; A chart goes straight into the cell's box; it cannot be inside a Text.
(defun cell-view (column content)
    `(Box (@ (width ,(second column)) (flexShrink 0) (paddingRight 1) (justifyContent ,(align column)))
        ,(if (chart? content) content `(Text (@ (wrap truncate-end)) ,content))))

(defun chart? (content)
    (and (pair? content) (eq? (car content) 'Sparkline)))

(defun endpoint-label (name)
    (if (eq? name "total") (title name) (bold name)))

(defun table-view (w st)
    `(Box (@ (flexDirection column) (paddingX 1))
        (Box (@ (flexDirection row)) ,@(map header-cell columns))
        ,@(map (lambda (name) (endpoint-row w st name)) endpoint-names)))

(defun endpoint-row (w st name)
    (row-of columns (endpoint-cells st name (workers-cell st name) (endpoint-queue-now w name))))

(defun endpoint-queue-now (w name)
    (if (eq? name "total")
        (fold (lambda (n e) (+ n (endpoint-queue w e))) 0 endpoint-names)
        (endpoint-queue w name)))

; An endpoint's row: its numbers are the last full second's.
(defun endpoint-cells (st name workers queue)
    (let ep (endpoint st name))
    (let s (ep-last ep))
    (let history (reverse (ep-history ep)))
    (list
        (endpoint-label name) workers (value->string queue) (value->string (vector-ref s 0))
        (bin-span (vector-ref s 2)) (bin-span (vector-ref s 4)) (value->string (vector-ref s 6))
        (sparkline 'cyan (map (lambda (h) (vector-ref h 0)) history) #false)
        ; Percentile bins, one higher so no data (-1) is blank; a fixed top
        ; keeps heights comparable from frame to frame.
        (sparkline 'magenta (map (lambda (h) (+ 1 (vector-ref h 5))) history) 11)))

; Drawn by the host (SPEC-TUI section 3.2), underlined so an empty history
; still shows as a line. `max` is #false to scale to the largest value.
(defun sparkline (color values max)
    `(Sparkline (@ (data ,values) (width ,history-length) (color ,color) (underline #true)
        ,@(if max (list (list 'max max)) ()))))

(defun acc-view (st)
    `(Box (@ (flexDirection column) (paddingX 1) (marginTop 1))
        (Box (@ (flexDirection row)) ,@(map header-cell acc-columns))
        (Box (@ (flexDirection row)) ,@(map header-cell (summary-columns acc-columns)))
        ,@(map (lambda (name) (acc-row st name)) endpoint-names)))

; The second header row: blank over the first two columns, and min, avg
; and max over each summary.
(defun summary-columns (cols)
    (cons (list "" (second (car cols)))
        (cons (list "" (second (second cols)))
            (map (lambda (c) (list (summary-header) (second c) 'right)) (cdr (cdr cols))))))

(defun summary-header ()
    (string-append (pad-left "min" 5) (pad-left "avg" 7) (pad-left "max" 6)))

(defun acc-row (st name)
    (let ep (endpoint st name))
    (row-of acc-columns
        (list
            (endpoint-label name) (value->string (ep-total ep))
            (summary-text (ep-queue-acc ep)) (summary-text (ep-rate-acc ep))
            (summary-text (ep-wait-acc ep)) (summary-text (ep-work-acc ep)))))

; min, avg (to a tenth) and max of a running summary, in 5, 7 and 6 columns.
(defun summary-text (a)
    (if (= (vector-ref a 0) 0)
        (string-append (pad-left "-" 5) (pad-left "-" 7) (pad-left "-" 6))
        (string-append
            (num (vector-ref a 2) 5)
            (pad-left (tenths (/ (* 10 (vector-ref a 1)) (vector-ref a 0))) 7)
            (num (vector-ref a 3) 6))))

; ---------------------------------------------------------------------------
; Workers: ● ready (green), ○ waiting in recv (dim), ◌ parked (blue). The
; hello pool shows one mark per worker and its maximum; the rest show counts.

(defun ready-count (procs)
    (fold (lambda (n p) (if (ready? p) (+ n 1) n)) 0 procs))

(defun dots (ready idle parked)
    (list (span 'green (repeat-string "●" ready)) (dim (repeat-string "○" idle)) (span 'blue (repeat-string "◌" parked))))

(defun counts (ready idle parked)
    (list
        (span 'green (string-append "● " (value->string ready)))
        (dim (string-append "  ○ " (value->string idle)))
        (span 'blue (string-append "  ◌ " (value->string parked)))))

(defun of-kind (procs kind)
    (fold (lambda (acc p) (if (eq? (proc-kind p) kind) (append acc (list p)) acc)) () procs))

(defun workers-cell (st name)
    (cond
        ((eq? name "hello")
            (let hello (of-kind (st-procs st) 'hello))
            (let ready (ready-count hello))
            (append (dots ready (- (length hello) ready) (length (st-cold st)))
                (list (string-append " " (value->string (length hello)) "/" (value->string (st-hello-max st))))))
        ((eq? name "counter")
            (let procs (counter-procs (st-procs st)))
            (let ready (ready-count procs))
            (counts ready (- (length procs) ready) (length (st-asleep st))))
        ((eq? name "slow") (kind-dots st 'slow))
        ((eq? name "router") (kind-dots st 'router))
        ((eq? name "system") (dim "the CPI"))
        ((eq? name "total")
            (let ready (ready-count (st-procs st)))
            (counts ready (- (length (st-procs st)) ready) (+ (length (st-cold st)) (length (st-asleep st)))))
        (#true "")))

(defun kind-dots (st kind)
    (let procs (of-kind (st-procs st) kind))
    (let ready (ready-count procs))
    (dots ready (- (length procs) ready) 0))

(defun repeat-string (s n)
    (if (<= n 0) "" (string-append s (repeat-string s (- n 1)))))
