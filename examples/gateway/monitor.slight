; Runs the gateway (gateway.slight) under a live monitor on the terminal:
;
;     node bin/cpi.ts examples/gateway/gateway.slight examples/gateway/monitor.slight
;
; Keys: q quits, + and - change the most hello workers.
;
; The CPI does not draw. It gives the plan's monitor node a view template,
; a view with placeholders where the numbers go (DESIGN-PLAN.md, SPEC-TUI),
; and the node fills it in and draws it in the host whenever it has
; something new: its summary for a new second, or a fact the CPI tells it.
; The one fact here is the most hello workers, which only the CPI knows.
;
; The CPI's events are not shown. Each is sent to a mailbox nobody receives
; on, so it ends up in the host's dead-letter queue.

(defun main ()
    (tui::open 'fullscreen)
    (let keys (mailbox::create #true 64))
    (tui::subscribe keys)
    (let started (start-gateway (list keys) (monitor-view)))
    (let ui (vector keys (dead-letter-box) 0 -1))
    (let final (gateway (car started) (second started) (cons monitor ui) ()))
    (http::close gateway-port)
    (tui::close)
    (IO::print "[gateway] stopped:" (stats final)))

; A mailbox whose only receiver has ended: everything sent to it is a dead
; letter.
(defun dead-letter-box ()
    (let box (mailbox::create #false 1))
    (let env (role (defun done () #true)))
    (process::run (process::spawn (environment::lookup env 'done) () env '() box) 10)
    box)

; The UI step: reads keys, sends new events to the dead-letter box, and tells
; the monitor node the most hello workers when it changes. The UI state is a
; vector: the keys mailbox, the dead-letter box, the newest event sent there,
; and the most hello workers the node was told.
(defun monitor (ui w st now)
    (let keyed (read-keys ui st))
    (let st2 (second keyed))
    (let ui2 (discard-events (car keyed) st2))
    (list (tell-hello-max w ui2 st2) st2 #false))

(defun tell-hello-max (w ui st)
    (if (= (st-hello-max st) (vector-ref ui 3))
        ui
        (do
            (mailbox::send (world-monitor-box w) (list 'set "hello-max" (st-hello-max st)))
            (vector-set ui 3 (st-hello-max st)))))

(defun newest-event (st)
    (if (nil? (st-events st)) 0 (car (car (st-events st)))))

(defun discard-events (ui st)
    (for-each (lambda (e) (mailbox::send (vector-ref ui 1) e)) (reverse (newer-than (st-events st) (vector-ref ui 2))))
    (vector-set ui 2 (newest-event st)))

(defun read-keys (ui st)
    (let event (mailbox::take (vector-ref ui 0)))
    (cond
        ((not event) (list ui st))
        ((eq? (car event) :key)
            (let handled (on-key (second event) (third event) ui st))
            (read-keys (car handled) (second handled)))
        (#true (read-keys ui st))))

(defun on-key (name mods ui st)
    (cond
        ((or (eq? name "q") (and (eq? name "c") (member? 'ctrl mods)))
            (list ui (stop (log-event st "quit from the keyboard"))))
        ((or (eq? name "+") (eq? name "="))
            (list ui (set-hello-max st (+ (st-hello-max st) 1))))
        ((eq? name "-")
            (list ui (set-hello-max st (- (st-hello-max st) 1))))
        (#true (list ui st))))

; ---------------------------------------------------------------------------
; The view template: a header, a row per endpoint for the last second, and a
; row per endpoint for everything since the start. The placeholders are
; (Metric row field), (Series row field), (Status name), (Fact name) and
; (Uptime); the node puts in the numbers every time it draws.

(defun dim (text) `(Text (@ (dimColor #true)) ,text))
(defun title (text) `(Text (@ (bold #true) (color cyan)) ,text))

(defun monitor-view ()
    `(Box (@ (flexDirection column))
        ,(header-view)
        ,(table-view)
        ,(acc-view)
        ,(dim " q quit · + / - hello max")))

(defun header-view ()
    `(Box (@ (borderStyle round) (borderColor cyan) (flexDirection column) (paddingX 1))
        (Text ,(title (string-append "gateway :" (value->string gateway-port)))
            ,(dim " · ") "up " (Uptime) ,(dim " · ") "hello max " (Fact "hello-max"))
        (Text (Text (@ (bold #true)) "requests " (Status "requests"))
            ,(dim " · ") (Text (@ (color green)) "2xx " (Status "2xx"))
            ,(dim " · ") (Text (@ (color yellow)) "4xx " (Status "4xx"))
            ,(dim " · ") (Text (@ (color red)) "503 " (Status "503"))
            ,(dim " · ") (Text (@ (color red)) "504 " (Status "504"))
            ,(dim " · ") (Text (@ (color red)) "5xx " (Status "5xx"))
            ,(dim " · ") (Text (@ (color yellow)) "gone " (Status "gone")))))

; Tables (SPEC-TUI section 16). The host lays them out: column widths,
; alignment and truncation.

(const columns
    '(("endpoint" 9) ("workers" 16) ("queue" 6 right) ("req/s" 6 right) ("wait p95" 9 right)
        ("work p95" 9 right) ("ticks/s" 9 right) ("req/s, 20 s" 20) ("p95, 20 s" 20)))

(defun endpoint-label (name)
    (if (eq? name "total") (title name) `(Text (@ (bold #true)) ,name)))

(defun table-view ()
    `(Box (@ (paddingX 1))
        (Table (@ (columns ,columns))
            ,@(map endpoint-row endpoint-names))))

; An endpoint's row: its numbers are the last full second's, its sparklines
; the last history-length seconds. The p95 series is a bin counted from 1,
; so a second without requests is blank; a fixed top keeps heights
; comparable from frame to frame.
(defun endpoint-row (name)
    `(Row ,(endpoint-label name) ,(workers-cell name) (Metric ,name queue) (Metric ,name requests)
        (Metric ,name wait-p95) (Metric ,name work-p95) (Metric ,name ticks)
        (Sparkline (@ (data (Series ,name requests)) (width ,history-length) (color cyan) (underline #true)))
        (Sparkline (@ (data (Series ,name total-p95)) (width ,history-length) (color magenta) (underline #true) (max 11)))))

; Workers: ● ready (green), ○ waiting (dim), ◌ parked by the pool or asleep
; (blue), counted by the host from the environments each row's processes
; run in. The CPI answers /system itself, and "other" has no processes.
(defun workers-cell (name)
    (cond
        ((eq? name "system") (dim "the CPI"))
        ((eq? name "other") "")
        (#true
            `((Text (@ (color green)) "● " (Metric ,name ready))
                (Text (@ (dimColor #true)) "  ○ " (Metric ,name waiting))
                (Text (@ (color blue)) "  ◌ " (Metric ,name parked))))))

; Since the start: min, avg and max of each running summary in columns of
; their own, under a two-row header whose first row spans each triple.
(const acc-columns
    '(("" 11) ("" 8 right)
        ("" 5 right) ("" 7 right) ("" 6 right)
        ("" 5 right) ("" 7 right) ("" 6 right)
        ("" 5 right) ("" 7 right) ("" 6 right)
        ("" 5 right) ("" 7 right) ("" 6 right)))

(defun acc-view ()
    `(Box (@ (paddingX 1) (marginTop 1))
        (Table (@ (header #false) (columns ,acc-columns))
            (Row (@ (dimColor #true)) "since start" "requests"
                (Cell (@ (span 3) (align right)) "queue") (Cell (@ (span 3) (align right)) "req/s")
                (Cell (@ (span 3) (align right)) "wait ms") (Cell (@ (span 3) (align right)) "work ms"))
            (Row (@ (dimColor #true)) "" "" "min" "avg" "max" "min" "avg" "max" "min" "avg" "max" "min" "avg" "max")
            ,@(map acc-row endpoint-names))))

(defun acc-row (name)
    `(Row ,(endpoint-label name) (Metric ,name total)
        (Metric ,name queue-min) (Metric ,name queue-avg) (Metric ,name queue-max)
        (Metric ,name rate-min) (Metric ,name rate-avg) (Metric ,name rate-max)
        (Metric ,name wait-min) (Metric ,name wait-avg) (Metric ,name wait-max)
        (Metric ,name work-min) (Metric ,name work-avg) (Metric ,name work-max)))
