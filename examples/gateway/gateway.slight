; A web gateway, as a library: the processes and the CPI's supervisor loop.
; `plain.slight` runs it printing what it does, and `monitor.slight` runs it
; under a live terminal monitor. Load this file first, then one of those.
;
; HTTP requests arrive as messages (SPEC-HTTP). A router actor forwards each
; to the endpoint its first path segment names, with that segment removed,
; and the endpoint answers through the request's reply address. The CPI is
; the supervisor: it schedules the processes, answers /system requests
; itself, and decides when workers wake, sleep and multiply.
;
;     /hello/<name>     a pool of identical workers on one shared queue
;     /counter/<name>   one counter per name, created on first use
;     /counter          the names counted so far
;     /slow             half a second of work: preemption keeps the rest going
;     /system/stats     the CPI's view of the processes
;     /system/metrics   what the monitor shows, as text
;     /system/quit      stops the gateway
;
; Three patterns, one per kind of endpoint:
;
; - Pre-warmed workers. One hello worker runs its warm-up and is parked as a
;   template. Every hello worker is unparked from it, already warm, onto the
;   shared queue: a mailbox with several receivers is a work queue.
; - Scaling. When requests wait in the hello queue, the CPI adds a worker, up
;   to the hello maximum. A worker idle for idle-ms is parked into cold
;   storage, down to hello-min, and the next scale-up unparks it from there.
; - Lazy, sleeping endpoints. The counters endpoint asks the CPI for a child
;   the first time a name is used. A counter idle for idle-ms is parked; its
;   mailbox is durable, so requests wait for it, and the CPI unparks it when
;   one does. Its count survives, because it is in the parked continuation.
;
; The CPI also keeps metrics: the host reports every finished request on the
; served log (http::subscribe-log), and process::ticks gives each
; process's cost. Run it, then try it with curl:
;
;     node bin/cpi.ts examples/gateway/gateway.slight examples/gateway/plain.slight
;     curl localhost:8080/hello/ada
;     curl localhost:8080/counter/ada
;     curl localhost:8080/system/metrics
;     curl localhost:8080/system/quit

(const gateway-port 8080)
(const request-timeout 2000)
(const quota 200)             ; ticks a process may run per turn
(const idle-ms 2000)          ; a worker idle this long is put to sleep
(const check-ms 500)          ; the longest the CPI waits when nothing is ready
(const hello-min 1)
(const hello-max-default 4)
(const hello-max-limit 16)
(const history-length 20)     ; seconds of history kept for each endpoint
(const events-kept 100)

; ---------------------------------------------------------------------------
; Inside the processes (granted actor)
; ---------------------------------------------------------------------------

; What every endpoint needs to read a request and answer it.
; A request is (request reply-to method path query headers body).
(defun http-library ()
    (role
        (require actor::send)

        (defun request-reply-to (req) (car (cdr req)))
        (defun request-path (req) (car (cdr (cdr (cdr req)))))

        ; The same request with `path` as its path: how a request is passed on
        ; with the segments already used taken off.
        (defun request-with-path (req path)
            (cons 'request
                (cons (request-reply-to req)
                    (cons (car (cdr (cdr req)))
                        (cons path (cdr (cdr (cdr (cdr req)))))))))

        (defun respond (req status body)
            (actor::send (request-reply-to req)
                (list 'response status (list (list "content-type" "text/plain")) body)))))

; `routes` is a list of (segment address), fixed when the router starts.
(defun router-code ()
    (role
        (require actor::recv actor::send request-path request-with-path respond)

        (defun router (routes)
            (let req (actor::recv))
            (let path (request-path req))
            (let to (if (nil? path) #false (route-to routes (car path))))
            (if to
                (actor::send to (request-with-path req (cdr path)))
                (respond req 404 "no such endpoint"))
            (router routes))

        (defun route-to (routes segment)
            (cond
                ((nil? routes) #false)
                ((eq? (car (car routes)) segment) (car (cdr (car routes))))
                (#true (route-to (cdr routes) segment))))))

; A hello worker. Its warm-up stands in for loading templates or opening
; connections, and `work` for rendering a page: both just spend ticks.
(defun hello-code ()
    (role
        (require actor::recv request-path respond)

        (defun hello-worker ()
            (let greeting (warm-up 300 "hello"))
            (hello-serve greeting))

        (defun hello-serve (greeting)
            (let req (actor::recv))
            (let path (request-path req))
            (work 12)
            (respond req 200 (string-append greeting ", " (if (nil? path) "world" (car path))))
            (hello-serve greeting))

        (defun warm-up (n greeting)
            (if (= n 0) greeting (warm-up (- n 1) greeting)))

        (defun work (n)
            (if (= n 0) #true (work (- n 1))))))

; The counters endpoint. `children` is a list of (name to), in the order the
; names were first used, where `to` is the child's address, or
; (pending req ...) while the CPI makes the child: requests for that name
; wait there until it exists.
(defun counters-code ()
    (role
        (require actor::recv actor::send actor::self request-path request-with-path respond)

        (defun counters (cpi children)
            (let msg (actor::recv))
            (counters cpi
                (case (car msg)
                    (:request (counters-request cpi children msg))
                    (:child (counters-adopt children (car (cdr msg)) (car (cdr (cdr msg)))))
                    (else children))))

        (defun counters-request (cpi children req)
            (let path (request-path req))
            (if (nil? path)
                (do
                    (respond req 200 (string-join " " (child-names children)))
                    children)
                (counters-forward cpi children (car path) (request-with-path req (cdr path)))))

        (defun counters-forward (cpi children name req)
            (let entry (find-child children name))
            (cond
                ((not entry)
                    (actor::send cpi (list 'make-counter name (actor::self)))
                    (append children (list (list name (list 'pending req)))))
                ((address? (car (cdr entry)))
                    (actor::send (car (cdr entry)) req)
                    children)
                (#true
                    (replace-child children name (append (car (cdr entry)) (list req))))))

        ; The CPI made the child: pass on what waited for it.
        (defun counters-adopt (children name to)
            (send-all to (cdr (car (cdr (find-child children name)))))
            (replace-child children name to))

        (defun send-all (to reqs)
            (when (not (nil? reqs))
                (actor::send to (car reqs))
                (send-all to (cdr reqs))))

        (defun find-child (children name)
            (cond
                ((nil? children) #false)
                ((eq? (car (car children)) name) (car children))
                (#true (find-child (cdr children) name))))

        (defun replace-child (children name to)
            (cond
                ((nil? children) ())
                ((eq? (car (car children)) name) (cons (list name to) (cdr children)))
                (#true (cons (car children) (replace-child (cdr children) name to)))))

        (defun child-names (children)
            (if (nil? children)
                ()
                (cons (car (car children)) (child-names (cdr children)))))))

; One counter. Its state is its arguments.
(defun counter-code ()
    (role
        (require actor::recv respond)

        (defun counter (name visits)
            (let req (actor::recv))
            (respond req 200 (string-append name " " (value->string (+ visits 1))))
            (counter name (+ visits 1)))))

; One worker for /slow. Its work takes about half a second of ticks, but the
; CPI runs it quota ticks at a time like every other process, so it slows
; nothing else down: it only gets its share.
(defun slow-code ()
    (role
        (require actor::recv respond)

        (defun slow-worker ()
            (let req (actor::recv))
            (spin 500000)
            (respond req 200 "slow, done")
            (slow-worker))

        (defun spin (n)
            (if (= n 0) #true (spin (- n 1))))))

; ---------------------------------------------------------------------------
; The CPI
; ---------------------------------------------------------------------------

; Lists.

(defun second (xs) (car (cdr xs)))
(defun third (xs) (car (cdr (cdr xs))))

(defun nth (xs i)
    (if (= i 0) (car xs) (nth (cdr xs) (- i 1))))

(defun map (f xs)
    (if (nil? xs) () (cons (f (car xs)) (map f (cdr xs)))))

(defun for-each (f xs)
    (when (not (nil? xs))
        (f (car xs))
        (for-each f (cdr xs))))

(defun fold (f acc xs)
    (if (nil? xs) acc (fold f (f acc (car xs)) (cdr xs))))

(defun length (xs)
    (fold (lambda (n x) (+ n 1)) 0 xs))

(defun reverse (xs)
    (fold (lambda (acc x) (cons x acc)) () xs))

(defun take (xs n)
    (if (or (nil? xs) (= n 0)) () (cons (car xs) (take (cdr xs) (- n 1)))))

(defun member? (x xs)
    (and (not (nil? xs)) (or (eq? x (car xs)) (member? x (cdr xs)))))

(defun min2 (a b) (if (< a b) a b))
(defun max2 (a b) (if (> a b) a b))

; ---------------------------------------------------------------------------
; Processes and the world they run in.

; A process's environment: its role and the HTTP library, nothing else.
(defun process-env (code)
    (environment::resolve (environment::compose (http-library) code) '(actor)))

(defun spawn-on (env name args mailbox)
    (process::spawn (environment::lookup env name) args env '(actor) mailbox))

; The CPI answers /system requests itself. It cannot call http-library's
; procedures, which run in processes (DECISIONS.md, Spec issues), so it has
; its own.
(defun cpi-respond (req status body)
    (mailbox::send (car (cdr req))
        (list 'response status (list (list "content-type" "text/plain")) body)))

; What stays fixed while the gateway runs: its mailboxes, the hello
; template, and the environments hello workers and counters run in.
(defun world (inbox queue template hello-env counter-env router-box counters-box log-box slow-box)
    (vector inbox queue template hello-env counter-env router-box counters-box log-box slow-box))
(defun world-inbox (w) (vector-ref w 0))
(defun world-queue (w) (vector-ref w 1))
(defun world-template (w) (vector-ref w 2))
(defun world-hello-env (w) (vector-ref w 3))
(defun world-counter-env (w) (vector-ref w 4))
(defun world-router-box (w) (vector-ref w 5))
(defun world-counters-box (w) (vector-ref w 6))
(defun world-log-box (w) (vector-ref w 7))
(defun world-slow-box (w) (vector-ref w 8))

; ---------------------------------------------------------------------------
; The CPI's state, a vector:
;
;   procs      the processes running, each (pid kind charged): kind is
;              router, counters, hello, slow or (counter name address), and
;              charged the ticks already added to its endpoint's metrics
;   cold       hello workers in cold storage, as parked data
;   asleep     counters asleep, each (name address parked)
;   running    #false once the gateway has been told to stop
;   hello-max  the most hello workers there may be
;   events     what the CPI has done, newest first, each (seq time text)
;   metrics    see Metrics below
;   plan       what the host runs (DESIGN-PLAN.md): the round, and the
;              mailboxes whose mail wakes the CPI, which are its own, the
;              UI's, and those of the counters asleep
;   inboxes    the CPI's and the UI's mailboxes

(defun state (procs inboxes)
    (with-asleep (vector procs () () #true hello-max-default () (new-metrics) () inboxes) ()))
(defun st-procs (st) (vector-ref st 0))
(defun st-cold (st) (vector-ref st 1))
(defun st-asleep (st) (vector-ref st 2))
(defun st-running? (st) (vector-ref st 3))
(defun st-hello-max (st) (vector-ref st 4))
(defun st-events (st) (vector-ref st 5))
(defun st-metrics (st) (vector-ref st 6))
(defun st-plan (st) (vector-ref st 7))
(defun with-procs (st procs) (vector-set st 0 procs))
(defun with-cold (st cold) (vector-set st 1 cold))
; The plan changes only when a counter falls asleep or wakes, so the host
; reads it again only then.
(defun with-asleep (st asleep)
    (vector-set (vector-set st 2 asleep) 7
        (list (list 'round quota idle-ms) (cons 'inbox (append (vector-ref st 8) (map second asleep))))))
(defun stop (st) (vector-set st 3 #false))
(defun with-metrics (st m) (vector-set st 6 m))

(defun proc-pid (p) (car p))
(defun proc-kind (p) (second p))
(defun proc-charged (p) (third p))

(defun add-proc (st pid kind)
    (with-procs st (append (st-procs st) (list (list pid kind 0)))))

(defun find-proc (procs pid)
    (cond
        ((nil? procs) #false)
        ((eq? (proc-pid (car procs)) pid) (car procs))
        (#true (find-proc (cdr procs) pid))))

(defun remove-proc (st pid)
    (with-procs st (fold (lambda (acc p) (if (eq? (proc-pid p) pid) acc (cons p acc))) () (reverse (st-procs st)))))

(defun log-event (st text)
    (let events (st-events st))
    (let seq (if (nil? events) 1 (+ 1 (car (car events)))))
    (vector-set st 5 (take (cons (list seq (host::now) text) events) events-kept)))

(defun set-hello-max (st n)
    (let max (max2 hello-min (min2 hello-max-limit n)))
    (log-event (vector-set st 4 max) (string-append "hello max " (value->string max))))

(defun count-kind (procs kind)
    (fold (lambda (n p) (if (eq? (proc-kind p) kind) (+ n 1) n)) 0 procs))

(defun counter-procs (procs)
    (fold (lambda (acc p) (if (pair? (proc-kind p)) (append acc (list p)) acc)) () procs))

(defun stats (st)
    (string-join " "
        (list
            "hello" (value->string (count-kind (st-procs st) 'hello))
            "cold" (value->string (length (st-cold st)))
            "counters" (value->string (length (counter-procs (st-procs st))))
            "asleep" (value->string (length (st-asleep st))))))

; ---------------------------------------------------------------------------
; Metrics.
;
; Request times go into histograms with fixed bins, so a percentile is a walk
; over eleven counts, not a sort: bin i holds times under the i-th bound in
; milliseconds, and the last bin the rest. Each endpoint keeps this second's
; histograms and a summary of each second before it.

(const bin-bounds '(1 2 5 10 20 50 100 200 500 1000))
(const bin-labels '("<1ms" "<2ms" "<5ms" "<10ms" "<20ms" "<50ms" "<100ms" "<200ms" "<500ms" "<1s" ">=1s"))
; `total` is the whole gateway: every request and every tick also counts
; there. No path reaches it.
(const endpoint-names '("hello" "counter" "slow" "router" "system" "other" "total"))

(defun bin-of (ms) (bin-walk ms bin-bounds 0))

(defun bin-walk (ms bounds i)
    (cond
        ((nil? bounds) i)
        ((< ms (car bounds)) i)
        (#true (bin-walk ms (cdr bounds) (+ i 1)))))

(defun new-hist () (make-vector 11 0))

(defun hist-add (h ms)
    (let i (bin-of ms))
    (vector-set h i (+ 1 (vector-ref h i))))

; The bin holding the q-th percentile of the n times in h; -1 if n is 0.
(defun hist-quantile (h n q)
    (if (= n 0) -1 (quantile-walk h (/ (+ (* n q) 99) 100) 0 0)))

(defun quantile-walk (h target i seen)
    (let now-seen (+ seen (vector-ref h i)))
    (if (or (>= now-seen target) (= i 10)) i (quantile-walk h target (+ i 1) now-seen)))

(defun bin-label (i) (if (< i 0) "-" (nth bin-labels i)))

; A running summary of a quantity since the start: (count sum min max).
(defun acc-new () (vector 0 0 0 0))

(defun acc-add (a x)
    (if (= (vector-ref a 0) 0)
        (vector 1 x x x)
        (vector (+ 1 (vector-ref a 0)) (+ x (vector-ref a 1)) (min2 x (vector-ref a 2)) (max2 x (vector-ref a 3)))))

; "min / avg / max", the average to one decimal place; "-" if empty.
(defun acc-text (a)
    (if (= (vector-ref a 0) 0)
        "-"
        (string-append
            (value->string (vector-ref a 2)) " / " (tenths (/ (* 10 (vector-ref a 1)) (vector-ref a 0)))
            " / " (value->string (vector-ref a 3)))))

(defun tenths (n)
    (string-append (value->string (/ n 10)) "." (value->string (% n 10))))

; An endpoint's metrics, a vector: requests in all; this second's requests,
; wait, work and total histograms, and ticks; the summaries of the seconds
; before, newest first; and running summaries since the start of wait and
; work (per request, in ms), of its queue (per loop), and of requests per
; second (per second). A summary is a vector: requests, the 50th and 95th
; percentile bins of wait and of work, the 95th of total, ticks.
(defun new-endpoint () (vector 0 0 (new-hist) (new-hist) (new-hist) 0 () (acc-new) (acc-new) (acc-new) (acc-new)))
(defun ep-total (ep) (vector-ref ep 0))
(defun ep-history (ep) (vector-ref ep 6))
(defun ep-wait-acc (ep) (vector-ref ep 7))
(defun ep-work-acc (ep) (vector-ref ep 8))
(defun ep-queue-acc (ep) (vector-ref ep 9))
(defun ep-rate-acc (ep) (vector-ref ep 10))

(defun add-request (ep wait work total)
    (let counted (vector-set (vector-set ep 0 (+ 1 (vector-ref ep 0))) 1 (+ 1 (vector-ref ep 1))))
    (let binned
        (vector-set (vector-set (vector-set counted 2 (hist-add (vector-ref ep 2) wait))
            3 (hist-add (vector-ref ep 3) work)) 4 (hist-add (vector-ref ep 4) total)))
    (vector-set (vector-set binned 7 (acc-add (vector-ref ep 7) wait)) 8 (acc-add (vector-ref ep 8) work)))

(defun add-queue-sample (ep n) (vector-set ep 9 (acc-add (vector-ref ep 9) n)))

(defun add-ep-ticks (ep n) (vector-set ep 5 (+ n (vector-ref ep 5))))

(defun summarize (ep)
    (let n (vector-ref ep 1))
    (vector n
        (hist-quantile (vector-ref ep 2) n 50) (hist-quantile (vector-ref ep 2) n 95)
        (hist-quantile (vector-ref ep 3) n 50) (hist-quantile (vector-ref ep 3) n 95)
        (hist-quantile (vector-ref ep 4) n 95) (vector-ref ep 5)))

(defun close-second (ep)
    (vector (vector-ref ep 0) 0 (new-hist) (new-hist) (new-hist) 0
        (take (cons (summarize ep) (vector-ref ep 6)) history-length)
        (vector-ref ep 7) (vector-ref ep 8) (vector-ref ep 9) (acc-add (vector-ref ep 10) (vector-ref ep 1))))

(defun close-seconds (ep n)
    (if (<= n 0) ep (close-seconds (close-second ep) (- n 1))))

; The last full second's summary.
(defun ep-last (ep)
    (if (nil? (ep-history ep)) (vector 0 -1 -1 -1 -1 -1 0) (car (ep-history ep))))

; All metrics, a vector: status counts (requests, 2xx and 3xx, 4xx, 503, 504,
; other 5xx, clients gone); each endpoint as (name metrics); this second's
; loop phases and the last second's, each a vector (loops plan other draw
; frames build) of counts and milliseconds, where plan is the time in
; plan::run (running processes and waiting), build is the part of draw spent
; making the view in CPI code, and the rest of draw is the host painting it;
; the current second; and the loop phases since the start.
(defun new-metrics ()
    (vector (make-vector 7 0) (map (lambda (name) (list name (new-endpoint))) endpoint-names)
        (make-vector 6 0) (make-vector 6 0) 0 (make-vector 6 0)))
(defun m-status (m) (vector-ref m 0))
(defun m-endpoints (m) (vector-ref m 1))
(defun m-phases (m) (vector-ref m 3))

(defun bump (v i) (vector-set v i (+ 1 (vector-ref v i))))

(defun endpoint (st name)
    (endpoint-in (m-endpoints (st-metrics st)) name))

(defun endpoint-in (eps name)
    (if (eq? (car (car eps)) name) (second (car eps)) (endpoint-in (cdr eps) name)))

(defun update-endpoint (st name f)
    (let m (st-metrics st))
    (with-metrics st
        (vector-set m 1
            (map (lambda (e) (if (eq? (car e) name) (list name (f (second e))) e)) (m-endpoints m)))))

(defun endpoint-of (path)
    (cond
        ((nil? path) "other")
        ((and (member? (car path) endpoint-names) (not (member? (car path) '("router" "total")))) (car path))
        (#true "other")))

(defun kind-endpoint (kind)
    (cond
        ((eq? kind 'hello) "hello")
        ((eq? kind 'router) "router")
        ((eq? kind 'slow) "slow")
        (#true "counter")))

(defun count-status (counts status)
    (let all (bump counts 0))
    (cond
        ((not (integer? status)) (bump all 6))
        ((< status 400) (bump all 1))
        ((< status 500) (bump all 2))
        ((= status 503) (bump all 3))
        ((= status 504) (bump all 4))
        (#true (bump all 5))))

; A served-log entry: (served port method path status arrived delivered
; answered). Wait is arrival to delivery (#false for a refusal, which never
; waited for a worker); work is delivery to answer.
(defun record-served (st entry)
    (let status (nth entry 4))
    (let arrived (nth entry 5))
    (let answered (nth entry 7))
    (let reached (if (nth entry 6) (nth entry 6) answered))
    (let m (st-metrics st))
    (let add (lambda (ep) (add-request ep (- reached arrived) (- answered reached) (- answered arrived))))
    (update-endpoint
        (update-endpoint (with-metrics st (vector-set m 0 (count-status (m-status m) status))) (endpoint-of (nth entry 3)) add)
        "total" add))

(defun add-ticks (st name n)
    (let add (lambda (ep) (add-ep-ticks ep n)))
    (if (= n 0) st (update-endpoint (update-endpoint st name add) "total" add)))

; Adds the ticks a process has used since it was last charged to its
; endpoint. Its entry in procs is not updated: see charge-all.
(defun charge (st p)
    (add-ticks st (kind-endpoint (proc-kind p)) (- (process::ticks (proc-pid p)) (proc-charged p))))

; Charges every process, once a second and not every turn: the round runs
; the turns in the host, so the CPI sees their ticks only as totals.
(defun charge-all (st)
    (with-procs (fold charge st (st-procs st))
        (map (lambda (p) (list (proc-pid p) (proc-kind p) (process::ticks (proc-pid p)))) (st-procs st))))

; Each endpoint's queue now: the requests waiting in the mailbox its router
; route leads to (a counter's own mailbox is not counted). `total` is them all.
(defun endpoint-queue (w name)
    (cond
        ((eq? name "hello") (mailbox::size (world-queue w)))
        ((eq? name "counter") (mailbox::size (world-counters-box w)))
        ((eq? name "slow") (mailbox::size (world-slow-box w)))
        ((eq? name "router") (mailbox::size (world-router-box w)))
        ((eq? name "system") (mailbox::size (world-inbox w)))
        (#true 0)))

; Adds this loop's queue lengths to the running summaries.
(defun sample-queues (w st)
    (let sizes (map (lambda (name) (list name (endpoint-queue w name))) endpoint-names))
    (let sum (fold (lambda (n s) (+ n (second s))) 0 sizes))
    (fold
        (lambda (acc s)
            (update-endpoint acc (car s) (lambda (ep) (add-queue-sample ep (if (eq? (car s) "total") sum (second s))))))
        st sizes))

; Starts a new second when host::now reaches one, closing the seconds
; between on every endpoint, after charging the ticks used since the last.
(defun roll-second (st0 now)
    (let s (/ now 1000))
    (let gap (min2 history-length (- s (vector-ref (st-metrics st0) 4))))
    (let st (if (> gap 0) (charge-all st0) st0))
    (let m (st-metrics st))
    (if (> gap 0)
        (with-metrics st
            (vector (m-status m)
                (map (lambda (e) (list (car e) (close-seconds (second e) gap))) (m-endpoints m))
                (make-vector 6 0) (vector-ref m 2) s (vector-ref m 5)))
        st))

(defun add-phases (st plan other draw)
    (let m (st-metrics st))
    (with-metrics st
        (vector-set (vector-set m 2 (phases-plus (vector-ref m 2) plan other draw))
            5 (phases-plus (vector-ref m 5) plan other draw))))

(defun phases-plus (p plan other draw)
    (vector (+ 1 (vector-ref p 0)) (+ plan (vector-ref p 1)) (+ other (vector-ref p 2))
        (+ draw (vector-ref p 3)) (vector-ref p 4) (vector-ref p 5)))

; A frame was drawn, and making its view took `build` ms.
(defun add-frame (st build)
    (let m (st-metrics st))
    (with-metrics st
        (vector-set (vector-set m 2 (frame-plus (vector-ref m 2) build)) 5 (frame-plus (vector-ref m 5) build))))

(defun frame-plus (p build)
    (vector-set (bump p 4) 5 (+ build (vector-ref p 5))))

; The metrics as text, for /system/metrics.
(defun metrics-text (st)
    (let counts (m-status (st-metrics st)))
    (string-join "\n"
        (append
            (list
                (string-join " "
                    (list "requests" (value->string (vector-ref counts 0))
                        "2xx" (value->string (vector-ref counts 1)) "4xx" (value->string (vector-ref counts 2))
                        "503" (value->string (vector-ref counts 3)) "504" (value->string (vector-ref counts 4))
                        "5xx" (value->string (vector-ref counts 5)) "gone" (value->string (vector-ref counts 6))))
                (phases-text "last-second" (m-phases (st-metrics st)))
                (phases-text "since-start" (vector-ref (st-metrics st) 5)))
            (map (lambda (e) (endpoint-text (car e) (second e))) (m-endpoints (st-metrics st))))))

(defun phases-text (label p)
    (string-join " "
        (list label "loops" (value->string (vector-ref p 0)) "plan" (value->string (vector-ref p 1))
            "other" (value->string (vector-ref p 2)) "draw" (value->string (vector-ref p 3))
            "frames" (value->string (vector-ref p 4)) "build" (value->string (vector-ref p 5)))))

(defun endpoint-text (name ep)
    (let s (ep-last ep))
    (string-join " "
        (list name "total" (value->string (ep-total ep)) "last-second" (value->string (vector-ref s 0))
            "wait-p95" (bin-label (vector-ref s 2)) "work-p95" (bin-label (vector-ref s 4))
            "total-p95" (bin-label (vector-ref s 5)) "ticks" (value->string (vector-ref s 6)))))

; ---------------------------------------------------------------------------
; Scheduling: the host runs the plan (plan::run), round after round, and
; returns what the CPI must act on: a process that ended, one idle in recv
; for idle-ms, which it may put to sleep, or mail in one of its mailboxes.

(defun ready? (p)
    (eq? (car (process::state (proc-pid p))) :ready))

(defun handle-events (w st events)
    (fold (lambda (acc event) (handle-event w acc event)) st events))

(defun handle-event (w st event)
    (let what (second event))
    (let p (find-proc (st-procs st) (car event)))
    (cond
        ; The CPI reads its own mailboxes every time it is woken; mail for a
        ; counter asleep wakes it.
        ((eq? (car what) :mail)
            (if (member? (car event) (vector-ref st 8)) st (wake-counter w st (car event))))
        ((not p) st)
        ((eq? (car what) :idle) (sleep-idle st p))
        ((or (eq? (car what) :exited) (eq? (car what) :failed))
            (log-event (remove-proc (charge st p) (proc-pid p))
                (string-join " " (list (value->string (proc-kind p)) "ended:" (value->string what)))))
        (#true st)))

; ---------------------------------------------------------------------------
; The CPI's mailboxes: /system requests and counters to make in its inbox,
; and the served log.

(defun handle-inbox (w st)
    (let msg (mailbox::take (world-inbox w)))
    (if msg
        (handle-inbox w (handle-message w st msg))
        st))

(defun handle-message (w st msg)
    (case (car msg)
        (:request (handle-system st msg))
        (:make-counter (make-counter w st (second msg) (third msg)))
        (else st)))

(defun handle-system (st req)
    (let path (car (cdr (cdr (cdr req)))))
    (let what (if (nil? path) "" (car path)))
    (cond
        ((eq? what "stats")
            (cpi-respond req 200 (stats st))
            st)
        ((eq? what "metrics")
            (cpi-respond req 200 (metrics-text st))
            st)
        ((eq? what "quit")
            (cpi-respond req 200 "bye")
            (stop st))
        (#true
            (cpi-respond req 404 "no such system request")
            st)))

(defun make-counter (w st name root)
    (let to (mailbox::create #true 100))
    (let pid (spawn-on (world-counter-env w) 'counter (list name 0) to))
    (mailbox::send root (list 'child name to))
    (add-proc (log-event st (string-append "counter " name " made")) pid (list 'counter name to)))

(defun read-served-log (w st)
    (let entry (mailbox::take (world-log-box w)))
    (if entry
        (read-served-log w (record-served st entry))
        st))

; ---------------------------------------------------------------------------
; Waking and scaling up.

; One more hello worker while requests wait and the pool is below its
; maximum: from cold storage if a worker is there, else from the template.
(defun scale-hello (w st)
    (if (and (> (mailbox::size (world-queue w)) 0)
            (< (count-kind (st-procs st) 'hello) (st-hello-max st)))
        (add-hello w st)
        st))

(defun add-hello (w st)
    (let cold (st-cold st))
    (let pid (process::unpark (if (nil? cold) (world-template w) (car cold)) (world-hello-env w)))
    (let added (add-proc (if (nil? cold) st (with-cold st (cdr cold))) pid 'hello))
    (log-event added
        (string-join " " (list "hello +1 from" (if (nil? cold) "the template:" "cold storage:") (stats added)))))

; A counter asleep wakes when the plan reports mail in its mailbox, which is
; in the plan's inbox while it sleeps.
(defun wake-counter (w st to)
    (let a (find-asleep (st-asleep st) to))
    (if a
        (do
            (let pid (process::unpark (third a) (world-counter-env w)))
            (let awake (with-asleep st (fold (lambda (acc b) (if (eq? b a) acc (cons b acc))) () (reverse (st-asleep st)))))
            (add-proc (log-event awake (string-append "counter " (car a) " awake")) pid (list 'counter (car a) (second a))))
        st))

(defun find-asleep (asleep to)
    (cond
        ((nil? asleep) #false)
        ((eq? (second (car asleep)) to) (car asleep))
        (#true (find-asleep (cdr asleep) to))))

; ---------------------------------------------------------------------------
; Sleeping: a hello worker beyond the minimum, or any counter, reported idle
; by the round, is parked.

(defun sleep-idle (st p)
    (cond
        ((and (eq? (proc-kind p) 'hello) (> (count-kind (st-procs st) 'hello) hello-min))
            (let parked (with-cold (remove-proc (charge st p) (proc-pid p)) (cons (process::park (proc-pid p)) (st-cold st))))
            (log-event parked (string-append "hello -1 to cold storage: " (stats parked))))
        ((pair? (proc-kind p))
            (let kind (proc-kind p))
            (let asleep (list (second kind) (third kind) (process::park (proc-pid p))))
            (log-event (with-asleep (remove-proc (charge st p) (proc-pid p)) (append (st-asleep st) (list asleep)))
                (string-append "counter " (second kind) " asleep")))
        (#true st)))

; ---------------------------------------------------------------------------
; Starting, and the supervisor loop.

; Starts a hello worker, runs it until its warm-up is done and it waits for
; its first request, and parks it: the template for every hello worker.
; Returns the parked data and how many turns the warm-up took.
(defun warm-template (env queue)
    (let pid (spawn-on env 'hello-worker () queue))
    (let turns (run-until-blocked pid 1))
    (list (process::park pid) turns))

(defun run-until-blocked (pid turns)
    (if (eq? (car (process::run pid quota)) :quota)
        (run-until-blocked pid (+ turns 1))
        turns))

; Makes the mailboxes, warms the template, starts the router, the counters
; endpoint and one hello worker, and starts listening. `ui-inboxes` are the
; UI's mailboxes (its keys), whose mail wakes the CPI as its own does.
; Returns (world state).
(defun start-gateway (ui-inboxes)
    (let inbox (mailbox::create #true 100))
    (let queue (mailbox::create #true 100))
    (let router-box (mailbox::create #true 100))
    (let counters-box (mailbox::create #true 100))
    (let log-box (mailbox::create #true 1000))
    (let slow-box (mailbox::create #true 100))
    (let hello-env (process-env (hello-code)))
    (let warm (warm-template hello-env queue))
    (let w (world inbox queue (car warm) hello-env (process-env (counter-code)) router-box counters-box log-box slow-box))
    (let routes (list (list "hello" queue) (list "counter" counters-box) (list "slow" slow-box) (list "system" inbox)))
    (let router (spawn-on (process-env (router-code)) 'router (list routes) router-box))
    (let counters (spawn-on (process-env (counters-code)) 'counters (list inbox ()) counters-box))
    (let slow (spawn-on (process-env (slow-code)) 'slow-worker () slow-box))
    (let st (log-event (state (list (list router 'router 0) (list counters 'counters 0) (list slow 'slow 0)) (cons inbox (cons log-box ui-inboxes)))
        (string-append "hello template warmed up in " (value->string (second warm)) " turns")))
    (http::listen gateway-port router-box request-timeout)
    (http::subscribe-log log-box)
    (list w (add-hello w (log-event st (string-append "listening on port " (value->string gateway-port))))))

; The supervisor loop. `ui` is (step . ui-state): once each time round, the
; loop calls (step ui-state w st now), which returns (ui-state st wait), where
; `wait` is the longest the loop may go before calling it again. `events` are
; what the last plan::run returned.
;
; The host runs the plan until the CPI is needed: a process ended or went
; idle, mail reached the CPI's inbox, its served log, the UI or a counter
; asleep, or `wait` passed. The CPI then does its own work, lets the UI step, and hands the
; plan back. It times each part with host::now: its own work, the UI, and
; the plan, which is running processes and waiting together.
(defun gateway (w st ui events)
    (if (st-running? st)
        (do
            (let t0 (host::now))
            (let st1 (sample-queues w (scale-hello w (read-served-log w (handle-inbox w (handle-events w (roll-second st t0) events))))))
            (let t1 (host::now))
            (let stepped ((car ui) (cdr ui) w st1 t1))
            (let st2 (second stepped))
            (let t2 (host::now))
            (let next (plan::run (st-plan st2) (third stepped)))
            (let t3 (host::now))
            (gateway w (add-phases st2 (- t3 t2) (- t1 t0) (- t2 t1)) (cons (car ui) (car stepped)) next))
        st))

; A UI step that prints each event once: `seen` is the newest one printed.
(defun print-events (seen w st now)
    (for-each (lambda (e) (IO::print "[gateway]" (third e))) (reverse (newer-than (st-events st) seen)))
    (list (if (nil? (st-events st)) seen (car (car (st-events st)))) st check-ms))

(defun newer-than (events seq)
    (if (or (nil? events) (<= (car (car events)) seq))
        ()
        (cons (car events) (newer-than (cdr events) seq))))
