; Views for the live demo, built by CPI code with quasiquote: a view reads
; like the screen it describes, with `,` for a value and `,@` to splice a
; list in.

; Two characters per cell, so cells look square in a terminal.
(defun lv-cell (c)
    (if (= c 1) "██" "··"))

(defun lv-row (row)
    `(Text (@ (color yellow)) ,(fold (lambda (s c) (string-append s (lv-cell c))) "" row)))

(defun lv-label (name value)
    `(Text (Text (@ (dimColor #true)) ,name " ") ,value))

(defun lv-view (gen board)
    `(Box (@ (gap 2))
        (Box (@ (flexDirection column) (borderStyle round) (borderColor green) (paddingX 1))
            ,@(map lv-row board))
        (Box (@ (flexDirection column) (paddingTop 1))
            (Text (@ (bold #true)) "Game of Life")
            ,(lv-label "generation" gen)
            ,(lv-label "live cells" (length (live-cells board))))))

; Every frame of the reference run, as a list of views.
(defun lv-views ()
    (lv-collect 0 (seed-board) ()))

(defun lv-collect (gen board acc)
    (if (> gen life-generations)
        (reverse acc)
        (lv-collect (+ gen 1) (step-board board) (cons (lv-view gen board) acc))))
