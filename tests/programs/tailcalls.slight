; Scenario 2: a 1,000,000-iteration tail-recursive loop, run both directly
; in the CPI and inside a spawned process, to show tail calls run in
; constant space.

(defun loop (n)
  (if (eq? n 0)
      :done
      (loop (- n 1))))

(defun main ()
  (let r1 (loop 1000000))
  (IO::print :cpi r1)
  (let p (process::spawn loop (cons 1000000 ()) (environment::self) '() #false))
  (let r2 (process::run p 20000000))
  (IO::print :process r2))
