{
    "compilerOptions": {
        "target": "es2024",
        "module": "nodenext",
        "noEmit": true,
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "bin/**/*",
        "spike/**/*"
    ]
}
